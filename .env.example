# Copy this file to .env and fill in your values
# Only the provider you use needs to be configured

# ---- Provider Selection ----
# Options: claude | openai | local
LLM_PROVIDER=claude

# ---- Claude (Anthropic) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- OpenAI ----
OPENAI_API_KEY=sk-...

# ---- Local vLLM ----
VLLM_URL=http://localhost:8000/v1
VLLM_MODEL=mistral-7b-instruct

# ---- Floe (x402 agentic credit layer on Base) ----
# Docs: https://floe-labs.gitbook.io/docs/developers/agent-quickstart
# Leave blank to disable — all other providers still work without it
#
# EVM wallet private key — this wallet holds your WETH/cbBTC collateral on Base
FLOE_PRIVATE_KEY=0x...
# Base mainnet RPC URL (Alchemy / Infura / Coinbase)
FLOE_RPC_URL=https://mainnet.base.org
# bytes32 market ID — run FloeClient().get_markets() to find available markets
FLOE_MARKET_ID=0x...
